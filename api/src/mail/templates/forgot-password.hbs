<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset your password</title>
  </head>
  <body style="margin:0; padding:0; background:#f5f7fb; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#111827;">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f5f7fb; padding:48px 20px;">
      <tr>
        <td align="center">
          <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:620px; background:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 8px 40px rgba(15,23,42,.08);">
            <tr>
              <td style="padding:32px 40px; border-bottom:1px solid #eef0f4;">
                <table width="100%" role="presentation">
                  <tr>
                    <td>
                      <div style="font-size:22px; font-weight:800; letter-spacing:-.5px;">
                        Foodx
                      </div>
                    </td>
                    <td align="right">
                      <span style="font-size:12px; font-weight:600; color:#6b7280; letter-spacing:.8px;">
                        PASSWORD RESET
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:52px 40px 32px;">
                <div style="display:inline-block; padding:7px 11px; background:#fff1e6; color:#FE8C00; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.3px; margin-bottom:20px;">
                  Reset your password
                </div>

                <h1 style="margin:0 0 18px; font-size:38px; line-height:1.1; letter-spacing:-1.5px; color:#111827;">
                  {{code}}
                </h1>

                <p style="margin:0; font-size:16px; line-height:1.7; color:#667085;">
                  Hi {{name}},<br /><br />
                  We received a request to reset the password for your Foodx account. Use the code above to continue with your password reset.
                  This code expires in 10 minutes. If you didn’t request this change, you can safely ignore this email.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:0 40px;">
                <div style="height:1px; background:#eef0f4;"></div>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding:28px 40px 36px;">
                <div style="font-size:13px; font-weight:700; color:#344054;">
                  Foodx
                </div>

                <p style="margin:8px 0 0; font-size:11px; line-height:1.6; color:#98a2b3;">
                  You're receiving this email because a password reset was requested for this account.
                  <br />
                  <a href="{{privacyUrl}}" style="color:#667085; text-decoration:none;">Privacy</a>
                  &nbsp;·&nbsp;
                  <a href="{{supportUrl}}" style="color:#667085; text-decoration:none;">Support</a>
                  <br />
                  © {{year}} Foodx. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
