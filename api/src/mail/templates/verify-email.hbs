<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <title>Activate your account</title> </head> <body style="margin:0; padding:0; background:#f5f7fb; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#111827;"> <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f5f7fb; padding:48px 20px;"> <tr> <td align="center">
    <!-- Container -->
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
      style="max-width:620px; background:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 8px 40px rgba(15,23,42,.08);">

      <!-- Header -->
      <tr>
        <td style="padding:32px 40px; border-bottom:1px solid #eef0f4;">
          <table width="100%" role="presentation">
            <tr>
              <td>
                <div style="font-size:22px; font-weight:800; letter-spacing:-.5px;">
                  Foodx
                </div>
              </td>
              <td align="right">
                <span style="font-size:12px; font-weight:600; color:#6b7280;">
                  WELCOME
                </span>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- Hero -->
      <tr>
        <td style="padding:52px 40px 32px;">

          <div style="display:inline-block; padding:7px 11px; background:#eef2ff; color:#FE8C00; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.3px; margin-bottom:20px;">
           Verify your email
          </div>

          <h1 style="margin:0 0 18px; font-size:38px; line-height:1.1; letter-spacing:-1.5px; color:#111827;">
           {code}
          </h1>

          <p style="margin:0; font-size:16px; line-height:1.7; color:#667085;">
            Hi {{name}},<br /><br />
            Thanks for joining Foodx. Activate your account to finish setting things up and start using the app.
            This code expires in 10 minutes. If you didn't request it, ignore this email.
          </p>

        </td>
      </tr>

     

      <!-- Divider -->
      <tr>
        <td style="padding:0 40px;">
          <div style="height:1px; background:#eef0f4;"></div>
        </td>
      </tr>




      <!-- Footer -->
      <tr>
        <td align="center" style="padding:28px 40px 36px;">

          <div style="font-size:13px; font-weight:700; color:#344054;">
            Foodx
          </div>

          <p style="margin:8px 0 0; font-size:11px; line-height:1.6; color:#98a2b3;">
            You're receiving this email because an account was created using this address.
            <br />
            © {{year}} Foodx. All rights reserved.
          </p>

        </td>
      </tr>

    </table>

  </td>
</tr>

</table> </body> </html>